From: J4im3x0 <36940599+J4im3x0@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:21:53 -0300
Subject: [PATCH] Backport armor swapping for modern clients

Capture the first framed handshake before local protocol translators rewrite it, then remove the observer. Keep legacy and unknown clients unchanged without consulting plugin APIs. Preserve armor NBT and creative durability and honor item-use cancellation.

diff --git a/src/main/java/com/hpfxd/pandaspigot/network/ClientProtocolDetector.java b/src/main/java/com/hpfxd/pandaspigot/network/ClientProtocolDetector.java
new file mode 100644
index 0000000000000000000000000000000000000000..ef77ea686e2d5dfff306bd3fb9702765fa848303
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/network/ClientProtocolDetector.java
@@ -0,0 +1,38 @@
+package com.hpfxd.pandaspigot.network;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import net.minecraft.server.NetworkManager;
+import net.minecraft.server.PacketDataSerializer;
+
+/** Observes the first framed packet before protocol translators rewrite it. */
+public final class ClientProtocolDetector extends ChannelInboundHandlerAdapter {
+    private final NetworkManager connection;
+
+    public ClientProtocolDetector(NetworkManager connection) {
+        this.connection = connection;
+    }
+
+    @Override
+    public void channelRead(ChannelHandlerContext context, Object message) throws Exception {
+        try {
+            if (message instanceof ByteBuf) {
+                PacketDataSerializer input = new PacketDataSerializer(((ByteBuf) message).duplicate());
+                if (input.e() == 0) {
+                    int protocol = input.e();
+                    input.c(Short.MAX_VALUE);
+                    input.readUnsignedShort();
+                    int intent = input.e();
+                    if (!input.isReadable() && intent >= 1 && intent <= 3) {
+                        connection.clientProtocolVersion = protocol;
+                    }
+                }
+            }
+        } catch (RuntimeException ignored) {
+            // The normal decoder remains responsible for rejecting malformed packets.
+        }
+        context.pipeline().remove(this);
+        context.fireChannelRead(message);
+    }
+}
