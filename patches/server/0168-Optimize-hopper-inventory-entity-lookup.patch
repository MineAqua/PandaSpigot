Subject: [PATCH] Optimize hopper inventory entity lookup


diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index b6704034f97892f344f98fa4abd0979d52f4c1c7..3c09649da997570d5e5df494421bd82f17ac47a4 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -1450,6 +1450,11 @@ public class Chunk {
         return this.entitySlices;
     }
 
+    public int getInventoryEntityCount(BlockPosition blockposition) { // PandaSpigot - FlamePaper: skip empty hopper inventory searches, using the correct entity counter
+        int i = MathHelper.clamp(MathHelper.floor(blockposition.getY() / 16.0D), 0, this.entitySlices.length - 1);
+        return this.inventoryEntityCounts[i];
+    }
+
     public boolean isDone() {
         return this.done;
     }
diff --git a/src/main/java/net/minecraft/server/TileEntityHopper.java b/src/main/java/net/minecraft/server/TileEntityHopper.java
index 760a0767eae7c148efd27c78a4a2f142507b75b7..6d7d170f3bb31dace565eb13c0615b39d41fb701 100644
--- a/src/main/java/net/minecraft/server/TileEntityHopper.java
+++ b/src/main/java/net/minecraft/server/TileEntityHopper.java
@@ -568,7 +568,7 @@ public class TileEntityHopper extends TileEntityContainer implements IHopper, IU
             }
         }
 
-        if (object == null) {
+        if (object == null && world.getChunkAtWorldCoords(blockposition).getInventoryEntityCount(blockposition) > 0) { // PandaSpigot - FlamePaper: skip empty inventory entity searches
             List list = world.a((Entity) null, new AxisAlignedBB(d0 - 0.5D, d1 - 0.5D, d2 - 0.5D, d0 + 0.5D, d1 + 0.5D, d2 + 0.5D), IEntitySelector.c);
 
             if (list.size() > 0) {
