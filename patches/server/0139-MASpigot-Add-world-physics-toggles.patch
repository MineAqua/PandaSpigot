     protected void a(MovingObjectPosition movingobjectposition) {
+        // MASpigot start - ender pearl block collision toggle
+        if (!com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().enderPearlBlockCollides) {
+            BlockPosition blockPosition = movingobjectposition.a();
+            if (blockPosition != null) {
+                Block block = world.getType(blockPosition).getBlock();
+                if (block == Blocks.FENCE_GATE || block == Blocks.SPRUCE_FENCE_GATE || block == Blocks.BIRCH_FENCE_GATE || block == Blocks.JUNGLE_FENCE_GATE || block == Blocks.DARK_OAK_FENCE_GATE || block == Blocks.ACACIA_FENCE_GATE) {
+                    BlockIterator iterator = null;
+
+                    try {
+                        Vector start = new Vector(locX, locY, locZ);
+                        Vector combined = new Vector(locX + motX, locY + motY, locZ + motZ);
+                        Vector direction = new Vector(combined.getX() - start.getX(), combined.getY() - start.getY(), combined.getZ() - start.getZ()).normalize();
+                        iterator = new BlockIterator(world.getWorld(), start, direction, 0.0, 1);
+                    } catch (IllegalStateException ignored) {
+                    }
+
+                    if (iterator != null) {
+                        boolean open = true;
+                        while (iterator.hasNext()) {
+                            org.bukkit.block.Block next = iterator.next();
+                            if (next.getState().getData() instanceof Gate && !((Gate) next.getState().getData()).isOpen()) {
+                                open = false;
+                                break;
+                            }
+                        }
+
+                        if (open) return;
+                    }
+                } else if (block == Blocks.DOUBLE_PLANT || block == Blocks.REEDS) return;
+            }
+        }
+        // MASpigot end
+
