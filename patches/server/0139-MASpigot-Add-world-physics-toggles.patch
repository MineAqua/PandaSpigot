From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MineAqua <mineaquanettm@gmail.com>
Date: Sat, 1 Aug 2026 16:53:02 -0400
Subject: [PATCH] MASpigot Add world physics toggles

Adds dropFloatingPlants (skip the vanilla break-if-unsupported check for BlockPlant-derived crops/plants/saplings), infiniteWaterSources (allow disabling new infinite water source formation), and enderPearlBlockCollides (allow thrown ender pearls to pass through open fence gates, double plants, and reeds instead of colliding with them).

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
index c63cd15c13b503d91ef0245ffe0de7f85dd6f540..e6bc80d7ee3b7a4190bbc6ae929499dec8550791 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
@@ -130,4 +130,23 @@ public class PandaSpigotConfig {
 
     @Comment("Protect spawn from explosions")
     public boolean betterSpawnProtection = true;
+
+    // MASpigot start - world physics toggles
+    @Comment("When enabled (vanilla behaviour), crops/plants/saplings that lose their\n" +
+        "supporting block break and drop as items. When disabled, they are\n" +
+        "allowed to remain floating in place instead.\n" +
+        "Default: true")
+    public boolean dropFloatingPlants = true;
+
+    @Comment("When enabled (vanilla behaviour), flowing water can form new infinite\n" +
+        "water sources. When disabled, water never creates new sources.\n" +
+        "Default: true")
+    public boolean infiniteWaterSources = true;
+
+    @Comment("When enabled (vanilla behaviour), thrown ender pearls collide with\n" +
+        "open fence gates, double plants, and reeds. When disabled, ender\n" +
+        "pearls pass through those blocks instead of colliding with them.\n" +
+        "Default: true")
+    public boolean enderPearlBlockCollides = true;
+    // MASpigot end
 }
