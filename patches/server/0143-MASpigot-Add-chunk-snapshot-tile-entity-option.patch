From: MineAqua <mineaquanettm@gmail.com>
Date: Sat, 1 Aug 2026 15:47:14 -0400
Subject: [PATCH] MASpigot Add chunk snapshot tile entity option

Adds Chunk#takeSnapshot()/restoreSnapshot(), a lightweight in-memory chunk snapshot (block data plus, optionally, tile entity NBT) that a plugin can capture and later restore in place, distinct from Bukkit's read-only ChunkSnapshot API. Chunk sections are cloned via new ChunkSection/NibbleArray snapshot helpers. Restoring a snapshot marks the chunk dirty and forces an immediate resend to viewing players via a new PlayerChunkMap#resend(x, z) helper.

diff --git a/src/main/java/net/minecraft/server/ChunkSection.java b/src/main/java/net/minecraft/server/ChunkSection.java
index 907c57b8cc6eba92597e5c2819bc972b05fd366b..2c1d80c36535c93350b6541c2ad4bc2fe55fa2d1 100644
--- a/src/main/java/net/minecraft/server/ChunkSection.java
+++ b/src/main/java/net/minecraft/server/ChunkSection.java
@@ -1,5 +1,7 @@
 package net.minecraft.server;
 
+import us.mineaqua.spigot.server.chunk.ChunkSectionSnapshot; // MASpigot
+
 public class ChunkSection {
 
     private int yPos;
@@ -145,4 +147,33 @@ public class ChunkSection {
     public void b(NibbleArray nibblearray) {
         this.skyLight = nibblearray;
     }
+
+    // MASpigot start - chunk snapshot with tile entities
+    private static char[] clone(char[] chars) {
+        return chars != null ? chars.clone() : null;
+    }
+
+    private static NibbleArray clone(NibbleArray array) {
+        return array != null ? array.clone() : null;
+    }
+
+    public ChunkSectionSnapshot createSnapshot() {
+        return new ChunkSectionSnapshot(
+                nonEmptyBlockCount,
+                tickingBlockCount,
+                clone(blockIds),
+                clone(emittedLight),
+                clone(skyLight)
+        );
+    }
+
+    public void restoreSnapshot(ChunkSectionSnapshot snapshot) {
+        nonEmptyBlockCount = snapshot.getNonEmptyBlockCount();
+        tickingBlockCount = snapshot.getTickingBlockCount();
+        blockIds = clone(snapshot.getBlockIds());
+        emittedLight = clone(snapshot.getEmittedLight());
+        skyLight = clone(snapshot.getSkyLight());
+        isDirty = true;
+    }
+    // MASpigot end
 }
diff --git a/src/main/java/net/minecraft/server/NibbleArray.java b/src/main/java/net/minecraft/server/NibbleArray.java
index a69c0bc8479d69ce9eefab48f13699d0402aa5cc..c8a01be3132146bba87be1a6e0c177040f8f5160 100644
