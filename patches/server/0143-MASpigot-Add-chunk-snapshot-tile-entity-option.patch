index 0000000000000000000000000000000000000000..eecdbb08abadb7a2010a33c11777a5b73a05c962
--- /dev/null
+++ b/src/main/java/us/mineaqua/spigot/server/chunk/ChunkSectionSnapshot.java
@@ -0,0 +1,47 @@
+package us.mineaqua.spigot.server.chunk;
+
+import net.minecraft.server.NibbleArray;
+
+// MASpigot - immutable snapshot of a ChunkSection's contents, used by Chunk#takeSnapshot()/restoreSnapshot()
+public final class ChunkSectionSnapshot {
+
+    private final int nonEmptyBlockCount;
+    private final int tickingBlockCount;
+    private final char[] blockIds;
+    private final NibbleArray emittedLight;
+    private final NibbleArray skyLight;
+
+    public ChunkSectionSnapshot(
+            int nonEmptyBlockCount,
+            int tickingBlockCount,
+            char[] blockIds,
+            NibbleArray emittedLight,
+            NibbleArray skyLight
+    ) {
+        this.nonEmptyBlockCount = nonEmptyBlockCount;
+        this.tickingBlockCount = tickingBlockCount;
+        this.blockIds = blockIds;
+        this.emittedLight = emittedLight;
+        this.skyLight = skyLight;
+    }
+
+    public int getNonEmptyBlockCount() {
+        return nonEmptyBlockCount;
+    }
+
+    public int getTickingBlockCount() {
+        return tickingBlockCount;
+    }
+
+    public char[] getBlockIds() {
+        return blockIds;
+    }
+
+    public NibbleArray getEmittedLight() {
+        return emittedLight;
+    }
+
+    public NibbleArray getSkyLight() {
+        return skyLight;
+    }
+}
diff --git a/src/main/java/us/mineaqua/spigot/server/chunk/CraftDummyChunkSnapshot.java b/src/main/java/us/mineaqua/spigot/server/chunk/CraftDummyChunkSnapshot.java
new file mode 100644
index 0000000000000000000000000000000000000000..49fa52ad3562fcfb048acf6053d2435efc90c73d
--- /dev/null
+++ b/src/main/java/us/mineaqua/spigot/server/chunk/CraftDummyChunkSnapshot.java
@@ -0,0 +1,31 @@
+package us.mineaqua.spigot.server.chunk;
+
+import net.minecraft.server.NBTTagCompound;
+import us.mineaqua.spigot.chunk.DummyChunkSnapshot;
+
+import java.util.ArrayList;
+import java.util.List;
+
+// MASpigot - server-side implementation of DummyChunkSnapshot, backed by ChunkSectionSnapshots and raw tile entity NBT
+public final class CraftDummyChunkSnapshot implements DummyChunkSnapshot {
+
+    private final ChunkSectionSnapshot[] sections;
+    private final List<NBTTagCompound> tileEntities;
+
+    public CraftDummyChunkSnapshot(ChunkSectionSnapshot[] sections, List<NBTTagCompound> tileEntities) {
+        this.sections = sections;
+        this.tileEntities = tileEntities;
+    }
+
+    public CraftDummyChunkSnapshot() {
+        this(new ChunkSectionSnapshot[16], new ArrayList<>());
+    }
+
+    public ChunkSectionSnapshot[] getSections() {
+        return sections;
+    }
+
+    public List<NBTTagCompound> getTileEntities() {
+        return tileEntities;
+    }
+}
