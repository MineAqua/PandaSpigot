diff --git a/src/main/java/org/bukkit/craftbukkit/CraftChunk.java b/src/main/java/org/bukkit/craftbukkit/CraftChunk.java
index c2f902c15e27da820a2d7c0aaad6d32429e1c6ff..5b1b6199f5cfc998cd6a2e07b9795b6b442e4a6c 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftChunk.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftChunk.java
@@ -1,7 +1,9 @@
 package org.bukkit.craftbukkit;
 
 import java.lang.ref.WeakReference;
+import java.util.ArrayList;
 import java.util.Arrays;
+import java.util.Map;
 
 import net.minecraft.server.*;
 
@@ -10,8 +12,14 @@ import org.bukkit.World;
 import org.bukkit.block.Block;
 import org.bukkit.block.BlockState;
 import org.bukkit.craftbukkit.block.CraftBlock;
+import org.bukkit.craftbukkit.entity.CraftHumanEntity;
 import org.bukkit.entity.Entity;
+import org.bukkit.entity.HumanEntity;
 import org.bukkit.ChunkSnapshot;
+// MASpigot start - chunk snapshot with tile entities
+import us.mineaqua.spigot.chunk.DummyChunkSnapshot;
+import us.mineaqua.spigot.server.chunk.CraftDummyChunkSnapshot;
+// MASpigot end
 
 public class CraftChunk implements Chunk {
     private WeakReference<net.minecraft.server.Chunk> weakChunk;
@@ -310,4 +318,106 @@ public class CraftChunk implements Chunk {
     static {
         Arrays.fill(emptySkyLight, (byte) 0xFF);
     }
+
+    // MASpigot start - chunk snapshot with tile entities
+    @Override
+    public DummyChunkSnapshot takeSnapshot() {
+        return takeSnapshot(false);
+    }
+
+    @Override
+    public DummyChunkSnapshot takeSnapshot(boolean includeTileEntities) {
+        net.minecraft.server.Chunk handle = getHandle();
+        CraftDummyChunkSnapshot snapshot = new CraftDummyChunkSnapshot();
+
+        // save chunk sections to snapshot
+        ChunkSection[] sections = handle.getSections();
+        for (int i = 0; i < sections.length; i++) {
+            if (sections[i] != null) {
+                snapshot.getSections()[i] = sections[i].createSnapshot();
+            }
+        }
+
+        if (!includeTileEntities || handle.tileEntities.isEmpty()) {
+            return snapshot;
+        }
+
+        // save tile entities to snapshot
+        for (Map.Entry<BlockPosition, TileEntity> entry : handle.tileEntities.entrySet()) {
+            NBTTagCompound nbt = new NBTTagCompound();
+            entry.getValue().b(nbt); // writeToNBT
+
+            // overwrite as a relative position to the chunk (& 15 always returns a positive value)
+            BlockPosition position = entry.getValue().getPosition();
+            nbt.setInt("x", position.getX() & 15);
+            nbt.setInt("z", position.getZ() & 15);
+
+            snapshot.getTileEntities().add(nbt);
+        }
+
+        return snapshot;
+    }
+
+    @Override
+    public void restoreSnapshot(DummyChunkSnapshot snapshot) {
+        restoreSnapshot(snapshot, false);
+    }
+
+    @Override
+    public void restoreSnapshot(DummyChunkSnapshot snapshot, boolean includeTileEntities) {
+        CraftDummyChunkSnapshot snap = (CraftDummyChunkSnapshot) snapshot;
+        net.minecraft.server.Chunk handle = getHandle();
+
+        // add chunk sections from snapshot
+        for (int i = 0; i < 16; i++) {
+            if (snap.getSections()[i] == null) {
+                handle.getSections()[i] = null;
+            } else {
+                handle.getSections()[i] = new ChunkSection(i << 4, !worldServer.worldProvider.o());
+                handle.getSections()[i].restoreSnapshot(snap.getSections()[i]);
+            }
+        }
+
+        if (includeTileEntities && !snap.getTileEntities().isEmpty()) {
+            // close any inventories currently open into a tile entity being replaced
+            for (TileEntity tileEntity : handle.tileEntities.values()) {
+                if (tileEntity instanceof IInventory) {
+                    for (HumanEntity human : new ArrayList<>(((IInventory) tileEntity).getViewers())) {
+                        if (human instanceof CraftHumanEntity) {
+                            ((CraftHumanEntity) human).getHandle().closeInventory();
+                        }
+                    }
+                }
+            }
+
+            // remove tile entities currently in the chunk to avoid duplicates
+            worldServer.tileEntityList.removeAll(handle.tileEntities.values());
+            handle.tileEntities.clear();
+
+            // add tile entities from snapshot
+            for (NBTTagCompound nbt : snap.getTileEntities()) {
+                // deserialize nbt to new tile entity instance
+                TileEntity tileEntity = TileEntity.c(nbt);
+
+                // tile entity position is relative to the chunk; move it into this chunk's space
+                BlockPosition relative = tileEntity.getPosition();
+                BlockPosition position = new BlockPosition(
+                        (handle.locX << 4) + relative.getX(),
+                        relative.getY(),
+                        (handle.locZ << 4) + relative.getZ()
+                );
+
+                tileEntity.a(worldServer);
+                tileEntity.a(position);
+                tileEntity.D();
+
+                handle.tileEntities.put(position, tileEntity);
+                worldServer.a(tileEntity); // adds it to the world's tick list if it needs ticking
+            }
+        }
+
+        handle.f(true);
+        worldServer.getPlayerChunkMap().resend(x, z);
+    }
+    // MASpigot end
 }
diff --git a/src/main/java/us/mineaqua/spigot/server/chunk/ChunkSectionSnapshot.java b/src/main/java/us/mineaqua/spigot/server/chunk/ChunkSectionSnapshot.java
