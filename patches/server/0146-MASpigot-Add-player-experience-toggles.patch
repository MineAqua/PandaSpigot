             this.disconnect("You have been idle for too long!");
         }
@@ -461,7 +461,7 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
 
                     AxisAlignedBB axisalignedbb = this.player.getBoundingBox().grow((double) f4, (double) f4, (double) f4).a(0.0D, -0.55D, 0.0D);
 
-                    if (!this.minecraftServer.getAllowFlight() && !this.player.abilities.canFly && !worldserver.c(axisalignedbb)) {
+                    if (com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().flightCheck && !this.minecraftServer.getAllowFlight() && !this.player.abilities.canFly && !worldserver.c(axisalignedbb)) { // MASpigot - flight check toggle
                         if (d16 >= -0.03125D) {
