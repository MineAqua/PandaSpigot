@@ -684,11 +684,15 @@ public class CraftPlayer extends CraftHumanEntity implements Player {
 
     @Override
     public void loadData() {
+        if (!com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().playerDataSaving) return; // MASpigot - player data saving toggle
+
         server.getHandle().playerFileData.load(getHandle());
     }
 
     @Override
     public void saveData() {
+        if (!com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().playerDataSaving) return; // MASpigot - player data saving toggle
+
         server.getHandle().playerFileData.save(getHandle());
     }
 
