             }
 
-            if (entityplayer1 == entityplayer || !entityplayer.getBukkitEntity().canSee(entityplayer1.getBukkitEntity())) { // PandaSpigot - don't include joining player
+            if (entityplayer1 == entityplayer || (hidePlayersFromTab && !entityplayer.getBukkitEntity().canSee(entityplayer1.getBukkitEntity()))) { // PandaSpigot - don't include joining player // MASpigot - hide players from tab toggle
                 continue;
             }
 
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
