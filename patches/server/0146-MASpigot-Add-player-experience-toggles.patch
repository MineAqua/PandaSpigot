+++ b/src/main/java/net/minecraft/server/PlayerList.java
@@ -280,6 +280,8 @@ public abstract class PlayerList {
     }
 
     public NBTTagCompound a(EntityPlayer entityplayer) {
+        if (!com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().playerDataSaving) return null; // MASpigot - player data saving toggle
+
         NBTTagCompound nbttagcompound = this.server.worlds.get(0).getWorldData().i(); // CraftBukkit
