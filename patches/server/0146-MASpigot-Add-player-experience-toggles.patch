From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MineAqua <mineaquanettm@gmail.com>
Date: Sat, 1 Aug 2026 16:54:00 -0400
Subject: [PATCH] MASpigot Add player experience toggles

Adds idleTimer, flightCheck, playerDataSaving, hidePlayersFromTab, and enderChestSlots. hidePlayersFromTab controls whether the join tab-list packets still respect visibility (canSee); playerDataSaving disables all player data load/save (position, inventory, enderchest, stats).

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
index 9492ebdd2c86f890fc2c2e1b27ab5ab41bddf8f6..31517908eae1d2d4d8d8ca5255f4502037a1a560 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
@@ -178,4 +178,32 @@ public class PandaSpigotConfig {
         "Default: true")
     public boolean chunksTicking = true;
     // MASpigot end
+
+    // MASpigot start - player experience toggles
+    @Comment("Whether players are disconnected for being idle past the configured\n" +
+        "idle-timeout. Disabling this ignores idle-timeout entirely.\n" +
+        "Default: true")
+    public boolean idleTimer = true;
+
+    @Comment("Whether the vanilla \"flying is not enabled on this server\" flight\n" +
+        "check kicks floating players.\n" +
+        "Default: true")
+    public boolean flightCheck = true;
+
+    @Comment("Whether players load/save their player data (position, inventory,\n" +
+        "enderchest, stats, etc) from/to disk.\n" +
+        "Default: true")
+    public boolean playerDataSaving = true;
+
+    @Comment("When enabled, the tab list only shows players a viewer can actually\n" +
+        "see (respects vanish/hidePlayer). When disabled, everyone shows up in\n" +
+        "the tab list regardless of visibility.\n" +
+        "Default: true")
+    public boolean hidePlayersFromTab = true;
+
+    @Comment("Number of slots in a player's ender chest. Vanilla is 27 (3 rows);\n" +
+        "should be a multiple of 9.\n" +
+        "Default: 27")
+    public int enderChestSlots = 27;
+    // MASpigot end
 }
diff --git a/src/main/java/net/minecraft/server/InventoryEnderChest.java b/src/main/java/net/minecraft/server/InventoryEnderChest.java
index 22c9b0b79960082cc5b94eb4c049cb914d6fc7d2..68b71b125dfb109480ffb55bdb99886402f8efac 100644
--- a/src/main/java/net/minecraft/server/InventoryEnderChest.java
