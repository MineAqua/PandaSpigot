+++ b/src/test/java/net/minecraft/server/NBTTagCompoundTest.java
@@ -0,0 +1,38 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertSame;
+
+import org.junit.Test;
+
+public class NBTTagCompoundTest {
+
+    @Test
+    public void clonePreservesSmallAndLargeCompounds() {
+        for (int size : new int[] { 0, 1, 6, 7, 16, 32 }) {
+            NBTTagCompound compound = new NBTTagCompound();
+            for (int i = 0; i < size; ++i) {
+                compound.setInt("key" + i, i);
+            }
+
+            NBTTagCompound clone = (NBTTagCompound) compound.clone();
+            assertNotSame(compound, clone);
+            assertEquals(compound, clone);
+
+            if (size > 0) {
+                clone.setInt("key0", -1);
+                assertEquals(0, compound.getInt("key0"));
+            }
+        }
+    }
+
+    @Test
+    public void missingIntArraysReuseTheSharedEmptyArray() {
+        NBTTagCompound compound = new NBTTagCompound();
+        NBTTagList list = new NBTTagList();
+
+        assertSame(compound.getIntArray("missing"), new NBTTagCompound().getIntArray("other"));
+        assertSame(compound.getIntArray("missing"), list.c(0));
+    }
+}
