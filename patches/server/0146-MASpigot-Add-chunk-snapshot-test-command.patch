+package us.mineaqua.spigot.server.chunk;
+
+import com.google.common.collect.ImmutableList;
+import org.apache.commons.lang.Validate;
+import org.bukkit.ChatColor;
+import org.bukkit.Chunk;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.bukkit.util.StringUtil;
+import us.mineaqua.spigot.chunk.DummyChunkSnapshot;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+// MASpigot - test command for copying and pasting restorable chunk snapshots
+public final class ChunkSnapshotCommand extends Command {
+
+    private static final List<String> SUBCOMMANDS = ImmutableList.of("copy", "paste", "clear");
+
+    private final Map<UUID, Clipboard> clipboards = new HashMap<>();
+
+    public ChunkSnapshotCommand() {
+        super("chunksnapshot", "Copy and paste chunk snapshots for testing", "/chunksnapshot <copy|paste|clear>",
+                ImmutableList.of("chunksnap"));
+        setPermission("maspigot.command.chunksnapshot");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String commandLabel, String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        if (!(sender instanceof Player)) {
+            sender.sendMessage(ChatColor.RED + "This command can only be used by a player.");
+            return true;
+        }
+
+        if (args.length != 1) {
+            sender.sendMessage(ChatColor.RED + "Usage: " + usageMessage);
+            return true;
+        }
+
+        Player player = (Player) sender;
+        UUID playerId = player.getUniqueId();
+
+        if (args[0].equalsIgnoreCase("copy")) {
+            Chunk chunk = player.getLocation().getChunk();
+            clipboards.put(playerId, new Clipboard(chunk.takeSnapshot(true), chunk.getWorld().getName(), chunk.getX(), chunk.getZ()));
+            player.sendMessage(ChatColor.GREEN + "Copied chunk " + formatChunk(chunk) + ChatColor.GREEN
+                    + " with tile entities.");
+            return true;
+        }
+
+        if (args[0].equalsIgnoreCase("paste")) {
+            Clipboard clipboard = clipboards.get(playerId);
+            if (clipboard == null) {
+                player.sendMessage(ChatColor.RED + "Copy a chunk first with /" + commandLabel + " copy.");
+                return true;
+            }
+
+            Chunk chunk = player.getLocation().getChunk();
+            chunk.restoreSnapshot(clipboard.snapshot, true);
+            player.sendMessage(ChatColor.GREEN + "Pasted chunk snapshot from " + ChatColor.YELLOW
+                    + clipboard.world + " [" + clipboard.x + ", " + clipboard.z + "]" + ChatColor.GREEN
+                    + " into " + formatChunk(chunk) + ChatColor.GREEN + ".");
+            return true;
+        }
+
+        if (args[0].equalsIgnoreCase("clear")) {
+            if (clipboards.remove(playerId) == null) {
+                player.sendMessage(ChatColor.YELLOW + "Your chunk snapshot clipboard is already empty.");
+            } else {
+                player.sendMessage(ChatColor.GREEN + "Cleared your chunk snapshot clipboard.");
+            }
+            return true;
+        }
+
+        sender.sendMessage(ChatColor.RED + "Usage: " + usageMessage);
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        Validate.notNull(sender, "Sender cannot be null");
+        Validate.notNull(alias, "Alias cannot be null");
+        Validate.notNull(args, "Arguments cannot be null");
+
+        if (args.length == 1) {
+            return StringUtil.copyPartialMatches(args[0], SUBCOMMANDS, new ArrayList<>(SUBCOMMANDS.size()));
+        }
+        return ImmutableList.of();
+    }
+
+    private static String formatChunk(Chunk chunk) {
+        return ChatColor.YELLOW + chunk.getWorld().getName() + " [" + chunk.getX() + ", " + chunk.getZ() + "]";
+    }
+
+    private static final class Clipboard {
+        private final DummyChunkSnapshot snapshot;
+        private final String world;
+        private final int x;
+        private final int z;
+
+        private Clipboard(DummyChunkSnapshot snapshot, String world, int x, int z) {
+            this.snapshot = snapshot;
+            this.world = world;
+            this.x = x;
+            this.z = z;
+        }
+    }
+}
