+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertNull;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.io.IOException;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+public class PacketPlayOutMultiBlockChangeTest extends AbstractTestingBase {
+
+    @Test
+    public void sharedPayloadMatchesLegacyPacketAndCanMaterializeInfos() throws IOException {
+        short[] positions = {
+                (short) ((3 << 12) | (7 << 8) | 64),
+                (short) ((4 << 12) | (8 << 8) | 65),
+                (short) ((5 << 12) | (9 << 8) | 66)
+        };
+        IBlockData[] states = {
+                Blocks.STONE.getBlockData(),
+                Blocks.DIRT.getBlockData(),
+                Blocks.REDSTONE_BLOCK.getBlockData()
+        };
+        ChunkCoordIntPair chunk = new ChunkCoordIntPair(-12, 27);
+
+        PacketPlayOutMultiBlockChange legacy = new PacketPlayOutMultiBlockChange();
+        legacy.setChunkCoordIntPair(chunk);
+        PacketPlayOutMultiBlockChange.MultiBlockChangeInfo[] infos =
+                new PacketPlayOutMultiBlockChange.MultiBlockChangeInfo[positions.length];
+        for (int i = 0; i < positions.length; ++i) {
+            infos[i] = legacy.new MultiBlockChangeInfo(positions[i], states[i]);
+        }
+        legacy.setMultiBlockChangeInfos(infos);
+
+        PacketPlayOutMultiBlockChange optimized = new PacketPlayOutMultiBlockChange();
+        optimized.setChunkCoordIntPair(chunk);
+        PacketPlayOutMultiBlockChange.SharedChanges shared =
+                new PacketPlayOutMultiBlockChange.SharedChanges(positions, states);
+        optimized.setSharedChanges(shared);
+
+        assertArrayEquals(serialize(legacy), serialize(optimized));
+        assertEquals(shared, new PacketPlayOutMultiBlockChange.SharedChanges(positions, states));
+        assertEquals(shared.hashCode(), new PacketPlayOutMultiBlockChange.SharedChanges(positions, states).hashCode());
+
+        PacketPlayOutMultiBlockChange.MultiBlockChangeInfo[] materialized = optimized.getMultiBlockChangeInfos();
+        assertNotSame(infos, materialized);
+        assertEquals(chunk.a(3, 64, 7), materialized[0].a());
+        assertEquals(states[1], materialized[1].c());
+        assertEquals(states[2], materialized[2].c());
+        assertNull(optimized.getSharedChanges());
+        assertArrayEquals(serialize(legacy), serialize(optimized));
+    }
+
+    private static byte[] serialize(PacketPlayOutMultiBlockChange packet) throws IOException {
+        ByteBuf buffer = Unpooled.buffer();
+        try {
+            packet.b(new PacketDataSerializer(buffer));
+            byte[] bytes = new byte[buffer.readableBytes()];
+            buffer.getBytes(buffer.readerIndex(), bytes);
+            return bytes;
+        } finally {
+            buffer.release();
+        }
+    }
+}
