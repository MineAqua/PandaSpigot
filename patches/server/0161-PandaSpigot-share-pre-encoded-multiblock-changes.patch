+    /** Immutable packet body shared by cage packets with identical block changes. */
+    public static final class SharedChanges {
+
+        private final short[] packedPositions;
+        private final IBlockData[] blockData;
+        private final byte[] encoded;
+        private final int hashCode;
+
+        public SharedChanges(short[] packedPositions, IBlockData[] blockData) {
+            if (packedPositions == null || blockData == null || packedPositions.length != blockData.length) {
+                throw new IllegalArgumentException("Block positions and states must have the same length");
+            }
+
+            this.packedPositions = packedPositions.clone();
+            this.blockData = blockData.clone();
+
+            ByteBuf buffer = Unpooled.buffer();
+            try {
+                PacketDataSerializer serializer = new PacketDataSerializer(buffer);
+                serializer.b(this.packedPositions.length);
+                for (int i = 0; i < this.packedPositions.length; ++i) {
+                    if (this.blockData[i] == null) {
+                        throw new IllegalArgumentException("Block state at index " + i + " is null");
+                    }
+                    serializer.writeShort(this.packedPositions[i]);
+                    serializer.b(Block.d.b(this.blockData[i]));
+                }
+
+                this.encoded = new byte[buffer.readableBytes()];
+                buffer.getBytes(buffer.readerIndex(), this.encoded);
+            } finally {
+                buffer.release();
+            }
+            this.hashCode = Arrays.hashCode(this.encoded);
+        }
+
+        public int size() {
+            return this.packedPositions.length;
+        }
+
+        public short getPackedPosition(int index) {
+            return this.packedPositions[index];
+        }
+
+        public IBlockData getBlockData(int index) {
+            return this.blockData[index];
+        }
+
+        @Override
+        public boolean equals(Object other) {
+            if (this == other) return true;
+            if (!(other instanceof SharedChanges)) return false;
+            return Arrays.equals(this.encoded, ((SharedChanges) other).encoded);
+        }
+
+        @Override
+        public int hashCode() {
+            return this.hashCode;
+        }
+    }
+
     public class MultiBlockChangeInfo {
 
         private final short b;
