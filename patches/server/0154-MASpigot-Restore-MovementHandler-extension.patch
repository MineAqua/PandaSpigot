From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MineAqua <mineaquanettm@gmail.com>
Date: Tue, 11 Aug 2026 00:00:00 -0400
Subject: [PATCH] MASpigot Restore MovementHandler extension

Restores MASpigot's movement handler registry and invokes registered
handlers for player location and rotation changes.

diff --git a/src/main/java/net/minecraft/server/PlayerConnection.java b/src/main/java/net/minecraft/server/PlayerConnection.java
index 64c9a9668..538bb537e 100644
--- a/src/main/java/net/minecraft/server/PlayerConnection.java
+++ b/src/main/java/net/minecraft/server/PlayerConnection.java
@@ -64,6 +64,8 @@ import co.aikar.timings.SpigotTimings; // Spigot
 // CraftBukkit end
 
 import org.github.paperspigot.PaperSpigotConfig; // PaperSpigot
+import us.mineaqua.spigot.movement.MovementHandler;
+import us.mineaqua.spigot.server.MASpigot;
 
 public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerListBox {
 
@@ -273,6 +275,26 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
                 double delta = Math.pow(this.lastPosX - to.getX(), 2) + Math.pow(this.lastPosY - to.getY(), 2) + Math.pow(this.lastPosZ - to.getZ(), 2);
                 float deltaAngle = Math.abs(this.lastYaw - to.getYaw()) + Math.abs(this.lastPitch - to.getPitch());
 
+                if (packetplayinflying.hasPos && delta > 0.0D && this.checkMovement && !this.player.dead) {
+                    for (MovementHandler handler : MASpigot.INSTANCE.getMovementHandlers()) {
+                        try {
+                            handler.onLocationChange(player, to, from);
+                        } catch (Exception e) {
+                            e.printStackTrace();
+                        }
+                    }
+                }
+
+                if (packetplayinflying.hasLook && deltaAngle > 0.0F && this.checkMovement && !this.player.dead) {
+                    for (MovementHandler handler : MASpigot.INSTANCE.getMovementHandlers()) {
+                        try {
+                            handler.onRotationChange(player, to, from);
+                        } catch (Exception e) {
+                            e.printStackTrace();
+                        }
+                    }
+                }
+
                 if ((delta > 1f / 256 || deltaAngle > 10f) && (this.checkMovement && !this.player.dead)) {
                     this.lastPosX = to.getX();
                     this.lastPosY = to.getY();
diff --git a/src/main/java/us/mineaqua/spigot/server/MASpigot.java b/src/main/java/us/mineaqua/spigot/server/MASpigot.java
new file mode 100644
index 000000000..d15ed0fe5
--- /dev/null
+++ b/src/main/java/us/mineaqua/spigot/server/MASpigot.java
@@ -0,0 +1,20 @@
+package us.mineaqua.spigot.server;
+
+import java.util.HashSet;
+import java.util.Set;
+import us.mineaqua.spigot.movement.MovementHandler;
+
+public enum MASpigot {
+
+    INSTANCE;
+
+    private final Set<MovementHandler> movementHandlers = new HashSet<>();
+
+    public Set<MovementHandler> getMovementHandlers() {
+        return movementHandlers;
+    }
+
+    public void registerMovementHandler(MovementHandler handler) {
+        movementHandlers.add(handler);
+    }
+}
