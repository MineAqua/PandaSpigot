From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MineAqua <mineaquanettm@gmail.com>
Date: Sat, 1 Aug 2026 16:53:19 -0400
Subject: [PATCH] MASpigot Add server tick toggles

Adds chunkUnload, entityCollisions, sleepCheck, villagesTicking, blocksTicking, and chunksTicking, each independently disabling that piece of the per-tick server/world work. MASpigot's mobAI toggle was intentionally not ported: PandaSpigot already has an equivalent, actively maintained option (PandaSpigotWorldConfig#disableEntityAi).

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
index e6bc80d7ee3b7a4190bbc6ae929499dec8550791..9492ebdd2c86f890fc2c2e1b27ab5ab41bddf8f6 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
@@ -149,4 +149,33 @@ public class PandaSpigotConfig {
         "Default: true")
     public boolean enderPearlBlockCollides = true;
     // MASpigot end
+
+    // MASpigot start - server tick toggles
+    @Comment("Whether chunks are allowed to unload. Disabling this keeps every\n" +
+        "loaded chunk in memory permanently.\n" +
+        "Default: true")
+    public boolean chunkUnload = true;
+
+    @Comment("Whether nearby entities push each other apart. Same idea as vanilla's\n" +
+        "collision rule, but as a single global on/off switch.\n" +
+        "Default: true")
+    public boolean entityCollisions = true;
+
+    @Comment("Whether everyone-is-sleeping detection (which skips the night and\n" +
+        "resets time/weather) is checked at all.\n" +
+        "Default: true")
+    public boolean sleepCheck = true;
+
+    @Comment("Whether villages and village sieges are ticked.\n" +
+        "Default: true")
+    public boolean villagesTicking = true;
+
+    @Comment("Whether scheduled block ticks (block updates) run.\n" +
+        "Default: true")
+    public boolean blocksTicking = true;
+
+    @Comment("Whether chunks are ticked (random block ticks, weather effects, etc).\n" +
+        "Default: true")
+    public boolean chunksTicking = true;
+    // MASpigot end
 }
