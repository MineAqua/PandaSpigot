+    // PandaSpigot start - parallel world ticking
+    @Comment("Whether independent worlds are ticked on dedicated worker lanes. This can run\n" +
+        "world and entity events from worker threads, so every installed plugin must be\n" +
+        "compatible with parallel world ticking and must not block waiting for server-thread\n" +
+        "work from a world event. This does not isolate chunks or regions inside a world.\n" +
+        "Cross-world entity transfers are skipped during a parallel tick.\n" +
+        "Default: false")
+    public boolean parallelWorldTicking = false;
+
+    @Comment("Maximum number of world tick worker lanes. Each world stays assigned to the\n" +
+        "same lane until it is unloaded or this setting changes. Values are limited to 2-16.\n" +
+        "Default: 2")
+    public int parallelWorldTickingThreads = 2;
+    // PandaSpigot end
