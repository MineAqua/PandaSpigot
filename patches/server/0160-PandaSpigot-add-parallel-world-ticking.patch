diff --git a/src/main/java/net/minecraft/server/ParallelWorldTickManager.java b/src/main/java/net/minecraft/server/ParallelWorldTickManager.java
new file mode 100644
index 000000000..4946e4981
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ParallelWorldTickManager.java
@@ -0,0 +1,237 @@
+package net.minecraft.server;
+
+import co.aikar.timings.Timings;
+import com.hpfxd.pandaspigot.config.PandaSpigotConfig;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+
+/**
+ * Runs independent world tick phases on stable, single-threaded lanes.
+ * World ticks are still joined before the server proceeds to connection and player ticks.
+ */
+public final class ParallelWorldTickManager {
+
+    private static final int MAX_LANES = 16;
+    private static final ThreadLocal<WorldServer> CURRENT_WORLD = new ThreadLocal<>();
+    private static final AtomicBoolean CROSS_WORLD_WARNING_LOGGED = new AtomicBoolean();
+
+    private final Map<WorldServer, Integer> worldLanes = new IdentityHashMap<>();
+    private List<ExecutorService> lanes = Collections.emptyList();
+    private boolean timingsWarningLogged;
+
+    /**
+     * @return true when ticks were dispatched to worker lanes; false when the caller should
+     *         use the regular serial tick path.
+     */
+    public boolean tickWorlds(List<WorldServer> worlds, Consumer<WorldServer> tickWorld) {
+        PandaSpigotConfig config = PandaSpigotConfig.get();
+        if (config == null || !config.parallelWorldTicking || worlds.size() < 2) {
+            if (!lanes.isEmpty()) {
+                shutdownLanes();
+                worldLanes.clear();
+            }
+            return false;
+        }
+
+        // A number of Spigot and Aikar timings are global mutable counters, not per-thread.
+        if (Timings.isTimingsEnabled()) {
+            if (!timingsWarningLogged) {
+                timingsWarningLogged = true;
+                MinecraftServer.LOGGER.warn("Parallel world ticking is enabled, but world ticks will remain serial while Timings is active.");
+            }
+            return false;
+        }
+
+        int laneCount = Math.max(2, Math.min(MAX_LANES, config.parallelWorldTickingThreads));
+        ensureLanes(laneCount);
+
+        List<WorldServer> snapshot = new ArrayList<>(worlds);
+        assignWorlds(snapshot);
+
+        List<List<WorldServer>> worldsByLane = new ArrayList<>(laneCount);
+        for (int i = 0; i < laneCount; i++) {
+            worldsByLane.add(new ArrayList<WorldServer>());
+        }
+        for (WorldServer world : snapshot) {
+            worldsByLane.get(worldLanes.get(world)).add(world);
+        }
+
+        List<Future<?>> futures = new ArrayList<>(laneCount);
+        for (int i = 0; i < laneCount; i++) {
+            final List<WorldServer> laneWorlds = worldsByLane.get(i);
+            if (laneWorlds.isEmpty()) {
+                continue;
+            }
+            futures.add(lanes.get(i).submit(() -> {
+                for (WorldServer world : laneWorlds) {
+                    CURRENT_WORLD.set(world);
+                    try {
+                        tickWorld.accept(world);
+                    } finally {
+                        CURRENT_WORLD.remove();
+                    }
+                }
+            }));
+        }
+
+        Throwable failure = null;
+        boolean interrupted = false;
+        for (Future<?> future : futures) {
+            boolean complete = false;
+            while (!complete) {
+                try {
+                    future.get();
+                    complete = true;
+                } catch (InterruptedException e) {
+                    // Do not let an interrupted wait leave world workers running into the next tick.
+                    interrupted = true;
+                } catch (ExecutionException e) {
+                    if (failure == null) {
+                        failure = e.getCause();
+                    }
+                    complete = true;
+                }
+            }
+        }
+
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+        if (failure != null) {
+            rethrow(failure);
+        }
+        if (interrupted) {
+            throw new IllegalStateException("Interrupted while waiting for parallel world ticks");
+        }
+        return true;
+    }
+
+    public static boolean isTickingWorld(WorldServer world) {
+        return CURRENT_WORLD.get() == world;
+    }
+
+    public static boolean isParallelWorldTickThread() {
+        return CURRENT_WORLD.get() != null;
+    }
+
+    public static void assertWorldAccess(World world, String operation) {
+        WorldServer currentWorld = CURRENT_WORLD.get();
+        if (currentWorld != null && currentWorld != world) {
+            throw new IllegalStateException("World tick worker cannot access another world during " + operation + "!");
+        }
+    }
+
+    public static boolean rejectCrossWorldTransfer(WorldServer from, WorldServer to) {
+        if (isTickingWorld(from) && from != to) {
+            if (CROSS_WORLD_WARNING_LOGGED.compareAndSet(false, true)) {
+                MinecraftServer.LOGGER.warn("A cross-world entity transfer was skipped during parallel world ticking. Disable parallel-world-ticking or perform transfers from the server thread.");
+            }
+            return true;
+        }
+        return false;
+    }
+
+    public void shutdown() {
+        shutdownLanes();
+        worldLanes.clear();
+    }
+
+    private void ensureLanes(int count) {
+        if (lanes.size() == count) {
+            return;
+        }
+        shutdownLanes();
+        List<ExecutorService> replacement = new ArrayList<>(count);
+        for (int i = 0; i < count; i++) {
+            final int lane = i;
+            ThreadFactory factory = runnable -> {
+                Thread thread = new Thread(runnable, "Panda world tick " + lane);
+                thread.setDaemon(true);
+                return thread;
+            };
+            replacement.add(Executors.newSingleThreadExecutor(factory));
+        }
+        lanes = replacement;
+        worldLanes.clear();
+    }
+
+    private void assignWorlds(List<WorldServer> worlds) {
+        Map<WorldServer, Boolean> loaded = new IdentityHashMap<>();
+        for (WorldServer world : worlds) {
+            loaded.put(world, Boolean.TRUE);
+        }
+        worldLanes.keySet().retainAll(loaded.keySet());
+
+        int[] laneLoads = new int[lanes.size()];
+        for (Integer lane : worldLanes.values()) {
+            laneLoads[lane]++;
+        }
+        for (WorldServer world : worlds) {
+            if (worldLanes.containsKey(world)) {
+                continue;
+            }
+            int leastLoadedLane = 0;
+            for (int lane = 1; lane < laneLoads.length; lane++) {
+                if (laneLoads[lane] < laneLoads[leastLoadedLane]) {
+                    leastLoadedLane = lane;
+                }
+            }
+            worldLanes.put(world, leastLoadedLane);
+            laneLoads[leastLoadedLane]++;
+        }
+    }
+
+    private void shutdownLanes() {
+        if (lanes.isEmpty()) {
+            return;
+        }
+        for (ExecutorService lane : lanes) {
+            lane.shutdown();
+        }
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        boolean interrupted = false;
+        for (ExecutorService lane : lanes) {
+            long remaining = deadline - System.nanoTime();
+            if (remaining <= 0) {
+                break;
+            }
+            try {
+                lane.awaitTermination(remaining, TimeUnit.NANOSECONDS);
+            } catch (InterruptedException e) {
+                interrupted = true;
+                break;
+            }
+        }
+        for (ExecutorService lane : lanes) {
+            if (!lane.isTerminated()) {
+                lane.shutdownNow();
+            }
+        }
+        lanes = Collections.emptyList();
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static void rethrow(Throwable failure) {
+        if (failure instanceof RuntimeException) {
+            throw (RuntimeException) failure;
+        }
+        if (failure instanceof Error) {
+            throw (Error) failure;
+        }
+        throw new RuntimeException(failure);
+    }
+}
