+public class KnockbackCommand extends Command {
+
+    private static final String STRAIGHT_CHAT_LINE = ChatColor.STRIKETHROUGH + Strings.repeat("-", 55);
+
+    private static final List<String> SUBCOMMANDS = ImmutableList.of("create", "delete", "edit", "use", "reset", "save", "save-all");
+    private static final KnockbackManager knockbackManager = KnockbackManager.INSTANCE;
+
+    public KnockbackCommand() {
+        super("knockback");
+
+        this.description = "Modify MASpigot's knockback properties";
+        this.usageMessage = "/knockback <create|delete|edit|use|reset|save|save-all> <profile>";
+
+        this.setPermission("maspigot.command.knockback");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String commandLabel, String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length < 1) {
+            sender.sendMessage(ChatColor.RED + "Usage: " + usageMessage);
+            return true;
+        }
+
+        if (args[0].equalsIgnoreCase("save-all")) {
+            try {
+                knockbackManager.save();
+            } catch (IOException e) {
+                sender.sendMessage(ChatColor.RED + "There was an error while saving existing knockback profiles.");
+                throw new RuntimeException(e);
+            }
+
+            sender.sendMessage(ChatColor.GREEN + "Saved all existing knockback profiles");
+            return true;
+        }
+
+        if (args[0].equalsIgnoreCase("reset")) {
+            if (!(sender instanceof Player)) {
+                sender.sendMessage(ChatColor.RED + "You must be a player to execute this sub-command.");
+                return true;
+            }
+
+            Player self = (Player) sender;
+            self.setKnockbackProfile(knockbackManager.defaultKnockback());
+            self.sendMessage(ChatColor.GREEN + "You are now using the " + ChatColor.WHITE + "default" + ChatColor.GREEN + " knockback profile.");
+            return true;
+        }
+
+        if (args.length < 2) {
+            sender.sendMessage(ChatColor.RED + "Usage: " + usageMessage);
+            return true;
+        }
+
+        final String name = args[1];
+        KnockbackProfile profile = knockbackManager.getProfile(name);
+
+        switch (args[0].toLowerCase()) {
+            case "create":
+                if (profile != null) {
+                    sender.sendMessage(ChatColor.RED + "Knockback profile named '" + name + "' already exists.");
+                    return true;
+                }
+
+                knockbackManager.createKnockbackProfile(name);
+                sender.sendMessage(ChatColor.GREEN + "Created knockback profile '" + ChatColor.GOLD + name + ChatColor.GREEN + "'.");
+                break;
+            case "delete":
+                if (profile == null) {
+                    sender.sendMessage(ChatColor.RED + "Knockback profile named '" + name + "' does not exists.");
+                    return true;
+                }
+
+                knockbackManager.delete(profile);
+                sender.sendMessage(ChatColor.GREEN + "Deleted knockback profile '" + ChatColor.GOLD + name + ChatColor.GREEN + "'.");
+                break;
+            case "edit":
+                if (profile == null) {
+                    sender.sendMessage(ChatColor.RED + "Knockback profile named '" + name + "' does not exists.");
+                    return true;
+                }
+
+                if (args.length < 3) {
+                    sendProfileValues(sender, profile);
+                    return true;
+                }
+
+                Option option = profile.getOption(args[2]);
+                if (option == null) {
+                    sender.sendMessage(ChatColor.RED + "Knockback option named '" + args[2] + "' does not exists.");
+                    return true;
+                }
+
+                if (args.length < 4) {
+                    sender.sendMessage(ChatColor.GRAY + "Current value for " + ChatColor.GOLD + option.getName() + ChatColor.GRAY + " is " + ChatColor.WHITE + option.getValue() + ChatColor.GRAY + ".");
+                    return true;
+                }
+
+                String input = args[3];
+                Object value = option.getValue();
+
+                try {
+                    if (value instanceof Integer) {
+                        value = Integer.parseInt(input);
+                    } else if (value instanceof Double) {
+                        value = Double.parseDouble(input);
+                    } else if (value instanceof Boolean) {
+                        value = Boolean.parseBoolean(input);
+                    }
+                } catch (Exception ex) {
+                    sender.sendMessage(ChatColor.RED + "Provided input can not be parsed for specified knockback option.");
+                    return true;
+                }
+
+                option.setValue(value);
+                sender.sendMessage(ChatColor.GREEN + "Set the " + ChatColor.GRAY + option.getName() + ChatColor.GREEN + " value of "
+                        + ChatColor.GOLD + profile.getName() + ChatColor.GREEN + " to " + ChatColor.WHITE + value + ChatColor.GOLD + '.');
+                break;
+            case "use":
