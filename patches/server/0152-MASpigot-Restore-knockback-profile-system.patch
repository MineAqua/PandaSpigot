+package us.mineaqua.spigot.server.knockback;
+
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+import us.mineaqua.spigot.knockback.KnockbackProfile;
+import us.mineaqua.spigot.option.Option;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+public enum KnockbackManager {
+
+    INSTANCE;
+
+    private static final String KNOCKBACK_DIRECTORY_NAME = "knockback";
+    private static final String DEFAULT_KNOCKBACK_NAME = "default";
+
+    private final Map<String, KnockbackProfile> profiles = new HashMap<>();
+
+    KnockbackManager() {
+        File knockback = new File(KNOCKBACK_DIRECTORY_NAME);
+        if (!knockback.exists()) {
+            knockback.mkdir();
+        }
+
+        File[] files = knockback.listFiles();
+        if (files != null) {
+            for (File file : files) {
+                if (!file.getName().endsWith(".yml")) {
+                    continue;
+                }
+
+                final YamlConfiguration config = new YamlConfiguration();
+                try {
+                    config.load(file);
+                } catch (IOException | InvalidConfigurationException e) {
+                    throw new RuntimeException(e);
+                }
+
+                final String name = file.getName().replace(".yml", "");
+
+                Map<String, Option> options = defaults();
+                for (Option option : options.values()) {
+                    final Object value = config.get(option.getName());
+                    if (value == null) {
+                        config.set(option.getName(), option.getValue());
+                    } else {
+                        option.setValue(value);
+                    }
+                }
+
+                try {
+                    config.save(file);
+                } catch (IOException e) {
+                    throw new RuntimeException(e);
+                }
+
+                profiles.put(name, new KnockbackProfile(name, options));
+            }
+        }
+
+        // store default knockback if it wasn't previously loaded.
+        if (!profiles.containsKey(DEFAULT_KNOCKBACK_NAME)) {
+            KnockbackProfile profile = new KnockbackProfile(DEFAULT_KNOCKBACK_NAME, defaults());
+
+            profiles.put(profile.getName(), profile);
+
+            try {
+                save(profile);
+            } catch (IOException e) {
+                throw new RuntimeException(e);
+            }
+        }
+    }
+
+    public boolean createKnockbackProfile(String name) {
+        if (profiles.containsKey(name)) {
+            return false;
+        }
+
+        final KnockbackProfile profile = new KnockbackProfile(name, defaults());
+        this.profiles.put(name, profile);
+        return true;
+    }
+
+    public KnockbackProfile getProfile(String name) {
+        return profiles.get(name);
+    }
+
+    public Collection<String> getProfileNames() {
+        return profiles.keySet();
+    }
+
+    public void save(KnockbackProfile profile) throws IOException {
+        File file = new File(KNOCKBACK_DIRECTORY_NAME + File.separator + profile.getName() + ".yml");
+        if (!file.exists()) {
+            file.getParentFile().mkdirs();
+            file.createNewFile();
+        }
+
+        YamlConfiguration config = new YamlConfiguration();
+        for (Option option : profile.getOptions()) {
+            config.set(option.getName(), option.getValue());
+        }
+
+        config.save(file);
+    }
+
+    public void save() throws IOException {
+        for (KnockbackProfile profile : profiles.values()) {
+            save(profile);
+        }
+    }
+
+    public void delete(KnockbackProfile profile) {
+        this.profiles.remove(profile.getName());
+
+        File file = new File(KNOCKBACK_DIRECTORY_NAME + File.separator + profile.getName() + ".yml");
+        if (file.exists()) {
+            file.delete();
+        }
+    }
+
+    public KnockbackProfile defaultKnockback() {
+        return profiles.get(DEFAULT_KNOCKBACK_NAME);
+    }
+
+    private static Map<String, Option> defaults() {
+        Map<String, Option> options = new LinkedHashMap<>();
+        register(options, Option.simple("hitDelay", 20));
+        register(options, Option.simple("onePointOne", false));
+        register(options, Option.simple("horizontal", 0.33));
+        register(options, Option.simple("inheritHorizontal", true));
+        register(options, Option.simple("horizontalFriction", 1.0));
+        register(options, Option.simple("groundHorizontal", 1.1));
+        register(options, Option.simple("horizontalSprint", 1.2));
+        register(options, Option.simple("attackerSlowdown", 0.6));
+        register(options, Option.simple("vertical", 0.33));
+        register(options, Option.simple("inheritVertical", false));
+        register(options, Option.simple("verticalFriction", 1.0));
+        register(options, Option.simple("groundVertical", 1.0));
+        register(options, Option.simple("verticalSprint", 1.0));
+        register(options, Option.simple("verticalLimit", 1.2));
+        register(options, Option.simple("cancelSprint", true));
+        register(options, Option.simple("comboMode", false));
+        register(options, Option.simple("comboHeight", 2.5));
+        register(options, Option.simple("comboTicks", 10));
+        register(options, Option.simple("comboVelocity", -0.05));
+        register(options, Option.simple("rodHorizontal", 0.9));
+        register(options, Option.simple("rodVertical", 1.0));
+        return options;
+    }
+
+    private static void register(Map<String, Option> map, Option option) {
+        map.put(option.getName(), option);
+    }
+}
