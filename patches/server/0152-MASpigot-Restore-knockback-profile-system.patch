+                    return true;
+                }
+
+                Player player = (Player) sender;
+                player.setKnockbackProfile(profile);
+                player.sendMessage(ChatColor.GREEN + "You are now using the " + ChatColor.WHITE + profile.getName() + ChatColor.GREEN + " knockback profile.");
+                break;
+            case "save":
+                if (profile == null) {
+                    sender.sendMessage(ChatColor.RED + "Knockback profile named '" + name + "' does not exists.");
+                    return true;
+                }
+
+                try {
+                    knockbackManager.save(profile);
+                } catch (IOException e) {
+                    sender.sendMessage(ChatColor.RED + "There was an error while saving knockback profile named '" + name + "'.");
+                    throw new RuntimeException(e);
+                }
+
+                sender.sendMessage(ChatColor.GREEN + "Knockback profile named '" + ChatColor.WHITE + name + ChatColor.GREEN + "' saved.");
+                break;
+            default:
+                sender.sendMessage(ChatColor.RED + "Usage: " + usageMessage);
+                break;
+        }
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        Validate.notNull(sender, "Sender cannot be null");
+        Validate.notNull(args, "Arguments cannot be null");
+        Validate.notNull(alias, "Alias cannot be null");
+
+        if (args.length == 1) {
+            return StringUtil.copyPartialMatches(args[0], SUBCOMMANDS, new ArrayList<>(SUBCOMMANDS.size()));
+        } else if (args.length == 2) {
+            Collection<String> profiles = knockbackManager.getProfileNames();
+            return StringUtil.copyPartialMatches(args[1], profiles, new ArrayList<>(profiles.size()));
+        } else if (args.length == 3) {
+            Collection<String> defaultOptions = knockbackManager.defaultKnockback().getOptionNames();
+            return StringUtil.copyPartialMatches(args[2], defaultOptions, new ArrayList<>(defaultOptions.size()));
+        }
+        return ImmutableList.of();
+    }
+
+    private void sendProfileValues(CommandSender sender, KnockbackProfile profile) {
+        sender.sendMessage(ChatColor.GRAY + STRAIGHT_CHAT_LINE);
+        sender.sendMessage(ChatColor.GOLD.toString() + ChatColor.BOLD + " " + profile.getName() + " Configuration");
+        sender.sendMessage("");
+        sender.sendMessage(ChatColor.GRAY + "  Hit Delay: " + ChatColor.WHITE + profile.getValue("hitDelay"));
+        sender.sendMessage("");
+        sender.sendMessage(ChatColor.GRAY + "  1.1 Knockback: " + ((boolean) profile.getValue("onePointOne") ? ChatColor.GREEN + "Yes" : ChatColor.RED + "No"));
+        sender.sendMessage(ChatColor.GRAY + "  Cancel Sprint: " + ((boolean) profile.getValue("cancelSprint") ? ChatColor.GREEN + "Yes" : ChatColor.RED + "No"));
+        sender.sendMessage("");
+        sender.sendMessage(ChatColor.GRAY + "  Vertical: " + ChatColor.WHITE + profile.getValue("vertical"));
+        sender.sendMessage(ChatColor.GRAY + "  Vertical Limit: " + ChatColor.WHITE + profile.getValue("verticalLimit"));
+        sender.sendMessage(ChatColor.GRAY + "  Horizontal: " + ChatColor.WHITE + profile.getValue("horizontal"));
+        sender.sendMessage(ChatColor.GRAY + "  Attacker Slowdown: " + ChatColor.WHITE + profile.getValue("attackerSlowdown"));
+        sender.sendMessage("");
+        sender.sendMessage(ChatColor.GOLD + "  Friction & Multipliers " + ChatColor.WHITE + "[Vertical, Horizontal]");
+        sender.sendMessage(ChatColor.GRAY + "   Friction: "
+                + ((boolean) profile.getValue("inheritVertical") ? ChatColor.GREEN : ChatColor.RED) + profile.getValue("verticalFriction")
+                + ChatColor.GRAY + " ❘ "
+                + ((boolean) profile.getValue("inheritHorizontal") ? ChatColor.GREEN : ChatColor.RED) + profile.getValue("horizontalFriction"));
+        sender.sendMessage(ChatColor.GRAY + "   Ground Multiplier: " + ChatColor.WHITE + profile.getValue("groundVertical") + ChatColor.GRAY + " ❘ " + ChatColor.WHITE + profile.getValue("groundHorizontal"));
+        sender.sendMessage(ChatColor.GRAY + "   Sprint Multiplier: " + ChatColor.WHITE + profile.getValue("verticalSprint") + ChatColor.GRAY + " ❘ " + ChatColor.WHITE + profile.getValue("horizontalSprint"));
+        sender.sendMessage("");
+        sender.sendMessage(ChatColor.GOLD + "  Rod Values");
+        sender.sendMessage(ChatColor.GRAY + "   Vertical: " + ChatColor.WHITE + profile.getValue("rodVertical"));
+        sender.sendMessage(ChatColor.GRAY + "   Horizontal: " + ChatColor.WHITE + profile.getValue("rodHorizontal"));
+        if ((boolean) profile.getValue("comboMode")) {
+            sender.sendMessage("");
+            sender.sendMessage(ChatColor.GOLD + "  Combo Values");
+            sender.sendMessage(ChatColor.GRAY + "   Ticks: " + ChatColor.WHITE + profile.getValue("comboTicks"));
+            sender.sendMessage(ChatColor.GRAY + "   Height: " + ChatColor.WHITE + profile.getValue("comboHeight"));
+            sender.sendMessage(ChatColor.GRAY + "   Velocity: " + ChatColor.WHITE + profile.getValue("comboVelocity"));
+        }
+        sender.sendMessage(ChatColor.GRAY + STRAIGHT_CHAT_LINE);
+    }
+}
