From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MineAqua <mineaquanettm@gmail.com>
Date: Sun, 2 Aug 2026 00:43:13 -0400
Subject: [PATCH] MASpigot Publish to MineAqua Reposilite

Replaces the hpfxd release repository with MineAqua's own Reposilite instance (https://repo.mineaqua.net/private), using mineaquaRepositoryUsername/mineaquaRepositoryPassword (or MINEAQUA_REPO_USERNAME/MINEAQUA_REPO_PASSWORD) for credentials.

diff --git a/build.gradle.kts b/build.gradle.kts
index 6e727d855493daeae6a2d8e649fad95ea25db1ce..edae9e604cab06f2158d191a0a940f7ef3ba7111 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -128,17 +128,17 @@ publishing {
         }
     }
 
-    (System.getenv("REPO_USERNAME") ?: findProperty("repository.hpfxd.username")).let { repoUsername ->
+    (System.getenv("MINEAQUA_REPO_USERNAME") ?: findProperty("mineaquaRepositoryUsername")).let { repoUsername ->
         if (repoUsername == null) return@let // don't declare repository if username not declared
 
         repositories {
             maven {
-                name = "hpfxd-repo"
-                url = uri("https://repo.hpfxd.com/releases/")
+                name = "mineaqua-repo"
+                url = uri("https://repo.mineaqua.net/private")
 
                 credentials {
                     username = repoUsername as String
-                    password = System.getenv("REPO_PASSWORD") ?: findProperty("repository.hpfxd.password") as String
+                    password = System.getenv("MINEAQUA_REPO_PASSWORD") ?: findProperty("mineaquaRepositoryPassword") as String
                 }
             }
         }
